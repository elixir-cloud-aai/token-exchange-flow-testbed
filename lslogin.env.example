# Settings for runs against LS Login. Copy to `lslogin.env` (git-ignored), fill
# in, and keep it private: it holds client secrets. Delete it after the session.
# Compose passes it to the containers at runtime only; it never goes into the
# image. Every variable is explained in docs/setup/configuration.md.
#
#   cp lslogin.env.example lslogin.env
#
# One `NAME=value` per line, no `export`, so that any shell and tool can read it.

TESTBED_PROVIDER=lslogin

# Client IDs, as shown by the registration app
TESTBED_NODE_CLIENT_ID=
TESTBED_GATEWAY_CLIENT_ID=
TESTBED_ORCHESTRATOR_CLIENT_ID=
TESTBED_CLIENT_CLIENT_ID=
TESTBED_PUBLIC_CLIENT_ID=

# Client secrets, as shown by the registration app. The public client has none
TESTBED_NODE_CLIENT_SECRET=
TESTBED_GATEWAY_CLIENT_SECRET=
TESTBED_ORCHESTRATOR_CLIENT_SECRET=
TESTBED_CLIENT_CLIENT_SECRET=

# Resource indicators in URL form, as registered
TESTBED_NODE_RESOURCE=https://tx-test-node.elixir-on.cloud/
TESTBED_GATEWAY_RESOURCE=https://tx-test-gateway.elixir-on.cloud/
TESTBED_ORCHESTRATOR_RESOURCE=https://tx-test-orchestrator.elixir-on.cloud/

# The node's policy; an example, to be compared with what `userinfo` shows
TESTBED_REQUIRED_ENTITLEMENT="urn:geant:lifescience-ri.eu:group:elixir:ECP_CLN#aai.lifescience-ri.eu"

# How services name their next hop in exchanges: audience, resource or both
TESTBED_TARGET_PARAM=audience
# Scope that services request in exchanges; empty for none
TESTBED_EXCHANGE_SCOPE=

# Issuer; empty for the one in current use (https://login.aai.lifescience-ri.eu/oidc/)
TESTBED_ISSUER=
